{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EmoticonPanel",
  "version": "0.2.0",
  "identifier": "com.grace.emoticonpanel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "表情面板",
        "width": 350,
        "height": 400,
        "minWidth": 300,
        "minHeight": 330,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}